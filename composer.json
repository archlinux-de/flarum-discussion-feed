{
    "name": "archlinux-de/flarum-discussion-feed",
    "description": "Simple and efficient Atom feed for Flarum",
    "license": "GPL-3.0-or-later",
    "type": "flarum-extension",
    "require": {
        "flarum/core": "^2.0.0",
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "ArchLinux\\DiscussionFeed\\": "src/",
            "ArchLinux\\DiscussionFeed\\Test\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Discussion Feed",
            "icon": {
                "name": "fas fa-rss",
                "backgroundColor": "#ee802f",
                "color": "#fff"
            }
        },
        "phpstan/extension-installer": {
            "ignore": [
                "larastan/larastan"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "nesbot/carbon": "^3.8",
        "flarum/phpstan": "^2.0",
        "illuminate/support": "^13.11"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
